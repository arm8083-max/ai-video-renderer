{
  "duration": 1958.12,
  "fps": 24,
  "frames": 46995,
  "paragraphs": [
    {
      "paragraph": 1,
      "part": 1,
      "start": 0.0,
      "end": 7.701,
      "duration": 7.701,
      "words": 18,
      "lead": "Шестнадцать опытных программистов."
    },
    {
      "paragraph": 2,
      "part": 1,
      "start": 8.051,
      "end": 20.458,
      "duration": 12.407,
      "words": 29,
      "lead": "Перед экспериментом разработчики были уверены, что поможет."
    },
    {
      "paragraph": 3,
      "part": 1,
      "start": 20.808,
      "end": 29.365,
      "duration": 8.557,
      "words": 20,
      "lead": "А теперь результат."
    },
    {
      "paragraph": 4,
      "part": 1,
      "start": 29.715,
      "end": 43.833,
      "duration": 14.118,
      "words": 33,
      "lead": "Но самое странное в этом исследовании даже не замедление."
    },
    {
      "paragraph": 5,
      "part": 1,
      "start": 44.183,
      "end": 53.167,
      "duration": 8.984,
      "words": 21,
      "lead": "Они работали медленнее на девятнадцать процентов и были уверены, что быстрее на двадцать."
    },
    {
      "paragraph": 6,
      "part": 1,
      "start": 53.517,
      "end": 63.358,
      "duration": 9.84,
      "words": 23,
      "lead": "Не о программистах."
    },
    {
      "paragraph": 7,
      "part": 1,
      "start": 63.708,
      "end": 98.79,
      "duration": 35.082,
      "words": 82,
      "lead": "Этот ролик о том, что искусственный интеллект переоценён."
    },
    {
      "paragraph": 8,
      "part": 1,
      "start": 99.14,
      "end": 129.088,
      "duration": 29.948,
      "words": 70,
      "lead": "Мы пройдём по пяти пунктам."
    },
    {
      "paragraph": 9,
      "part": 1,
      "start": 129.438,
      "end": 141.417,
      "duration": 11.979,
      "words": 28,
      "lead": "И ещё одно."
    },
    {
      "paragraph": 10,
      "part": 1,
      "start": 141.767,
      "end": 145.19,
      "duration": 3.423,
      "words": 8,
      "lead": "Начнём с главного: что вообще значит слово переоценён."
    },
    {
      "paragraph": 11,
      "part": 1,
      "start": 145.54,
      "end": 173.349,
      "duration": 27.809,
      "words": 65,
      "lead": "Переоценённым может быть что-то абсолютно реальное."
    },
    {
      "paragraph": 12,
      "part": 1,
      "start": 173.699,
      "end": 190.384,
      "duration": 16.685,
      "words": 39,
      "lead": "Или интернет."
    },
    {
      "paragraph": 13,
      "part": 1,
      "start": 190.734,
      "end": 207.419,
      "duration": 16.685,
      "words": 39,
      "lead": "Вот что такое переоценка."
    },
    {
      "paragraph": 14,
      "part": 1,
      "start": 207.769,
      "end": 227.877,
      "duration": 20.108,
      "words": 47,
      "lead": "А ещё в тысяча девятьсот восемьдесят седьмом году экономист Роберт Солоу заметил: компьютерная эпоха видна везде, кроме статистики производительности."
    },
    {
      "paragraph": 15,
      "part": 1,
      "start": 228.227,
      "end": 230.794,
      "duration": 2.567,
      "words": 6,
      "lead": "Позиция первая."
    },
    {
      "paragraph": 16,
      "part": 1,
      "start": 231.144,
      "end": 248.258,
      "duration": 17.113,
      "words": 40,
      "lead": "Каждый раз, когда выходит новая модель, нам показывают таблицу."
    },
    {
      "paragraph": 17,
      "part": 1,
      "start": 248.608,
      "end": 278.556,
      "duration": 29.948,
      "words": 70,
      "lead": "Есть закон Гудхарта: когда показатель становится целью, он перестаёт быть хорошим показателем."
    },
    {
      "paragraph": 18,
      "part": 1,
      "start": 278.906,
      "end": 323.828,
      "duration": 44.922,
      "words": 105,
      "lead": "Пример, который я люблю."
    },
    {
      "paragraph": 19,
      "part": 1,
      "start": 324.178,
      "end": 344.714,
      "duration": 20.536,
      "words": 48,
      "lead": "Второй слой проблемы."
    },
    {
      "paragraph": 20,
      "part": 1,
      "start": 345.064,
      "end": 395.12,
      "duration": 50.056,
      "words": 117,
      "lead": "Исследователи это видят."
    },
    {
      "paragraph": 21,
      "part": 2,
      "start": 395.12,
      "end": 430.347,
      "duration": 35.227,
      "words": 77,
      "lead": "Теперь галлюцинации."
    },
    {
      "paragraph": 22,
      "part": 2,
      "start": 430.697,
      "end": 451.741,
      "duration": 21.045,
      "words": 46,
      "lead": "Многие исследователи называют это рваным интеллектом: модель может решить задачу, над которой бьются аспиранты, и тут же споткнуться на том, что ребёнок делает не думая."
    },
    {
      "paragraph": 23,
      "part": 2,
      "start": 452.091,
      "end": 467.189,
      "duration": 15.097,
      "words": 33,
      "lead": "Итак, пункт первый."
    },
    {
      "paragraph": 24,
      "part": 2,
      "start": 467.539,
      "end": 469.826,
      "duration": 2.287,
      "words": 5,
      "lead": "Позиция вторая."
    },
    {
      "paragraph": 25,
      "part": 2,
      "start": 470.176,
      "end": 491.221,
      "duration": 21.045,
      "words": 46,
      "lead": "В тысяча девятьсот шестьдесят шестом году учёный Джозеф Вайценбаум из Массачусетского технологического института написал программу Элиза."
    },
    {
      "paragraph": 26,
      "part": 2,
      "start": 491.571,
      "end": 517.648,
      "duration": 26.077,
      "words": 57,
      "lead": "Вайценбаум потом вспоминал, что люди, прекрасно знавшие, как программа устроена, всё равно начинали с ней откровенничать."
    },
    {
      "paragraph": 27,
      "part": 2,
      "start": 517.998,
      "end": 552.309,
      "duration": 34.312,
      "words": 75,
      "lead": "А теперь представьте Элизу, которая научилась читать почти весь интернет."
    },
    {
      "paragraph": 28,
      "part": 2,
      "start": 552.659,
      "end": 588.344,
      "duration": 35.684,
      "words": 78,
      "lead": "Добавьте к этому ещё одну вещь, о которой говорят реже."
    },
    {
      "paragraph": 29,
      "part": 2,
      "start": 588.694,
      "end": 637.645,
      "duration": 48.952,
      "words": 107,
      "lead": "Чем это заканчивается, когда уверенность принимают за знание?"
    },
    {
      "paragraph": 30,
      "part": 2,
      "start": 637.995,
      "end": 655.837,
      "duration": 17.842,
      "words": 39,
      "lead": "Заметьте: в каждом из этих случаев ошибка не выглядела как ошибка."
    },
    {
      "paragraph": 31,
      "part": 2,
      "start": 656.187,
      "end": 680.434,
      "duration": 24.247,
      "words": 53,
      "lead": "Короткая пауза на вопрос."
    },
    {
      "paragraph": 32,
      "part": 2,
      "start": 680.784,
      "end": 683.987,
      "duration": 3.202,
      "words": 7,
      "lead": "Позиция третья."
    },
    {
      "paragraph": 33,
      "part": 2,
      "start": 684.337,
      "end": 710.414,
      "duration": 26.077,
      "words": 57,
      "lead": "Вернёмся к тем шестнадцати программистам."
    },
    {
      "paragraph": 34,
      "part": 2,
      "start": 710.764,
      "end": 750.108,
      "duration": 39.344,
      "words": 86,
      "lead": "Теперь честно про ограничения, потому что я обещал."
    },
    {
      "paragraph": 35,
      "part": 2,
      "start": 750.458,
      "end": 779.28,
      "duration": 28.822,
      "words": 63,
      "lead": "Но вот что важно для нас."
    },
    {
      "paragraph": 36,
      "part": 3,
      "start": 779.28,
      "end": 816.798,
      "duration": 37.518,
      "words": 83,
      "lead": "Справедливости ради, есть и обратные данные."
    },
    {
      "paragraph": 37,
      "part": 3,
      "start": 817.148,
      "end": 860.995,
      "duration": 43.847,
      "words": 97,
      "lead": "Есть и ещё одна скрытая статья расходов."
    },
    {
      "paragraph": 38,
      "part": 3,
      "start": 861.345,
      "end": 892.987,
      "duration": 31.642,
      "words": 70,
      "lead": "Ещё пример: шведская финтех компания Клярна."
    },
    {
      "paragraph": 39,
      "part": 3,
      "start": 893.337,
      "end": 932.212,
      "duration": 38.874,
      "words": 86,
      "lead": "Теперь на уровне целых экономик."
    },
    {
      "paragraph": 40,
      "part": 3,
      "start": 932.562,
      "end": 988.613,
      "duration": 56.052,
      "words": 124,
      "lead": "И ещё одна цифра, которую вы, возможно, видели в заголовках."
    },
    {
      "paragraph": 41,
      "part": 3,
      "start": 988.963,
      "end": 1003.428,
      "duration": 14.465,
      "words": 32,
      "lead": "Итого, пункт третий."
    },
    {
      "paragraph": 42,
      "part": 3,
      "start": 1003.778,
      "end": 1006.49,
      "duration": 2.712,
      "words": 6,
      "lead": "Позиция четвёртая."
    },
    {
      "paragraph": 43,
      "part": 3,
      "start": 1006.84,
      "end": 1038.482,
      "duration": 31.642,
      "words": 70,
      "lead": "Давайте про масштаб."
    },
    {
      "paragraph": 44,
      "part": 3,
      "start": 1038.832,
      "end": 1072.283,
      "duration": 33.45,
      "words": 74,
      "lead": "Вопрос в том, откуда возьмутся деньги на возврат этих денег."
    },
    {
      "paragraph": 45,
      "part": 3,
      "start": 1072.633,
      "end": 1100.658,
      "duration": 28.026,
      "words": 62,
      "lead": "Что говорят сами руководители?"
    },
    {
      "paragraph": 46,
      "part": 3,
      "start": 1101.008,
      "end": 1149.376,
      "duration": 48.367,
      "words": 107,
      "lead": "Теперь посмотрим на кривую ожиданий."
    },
    {
      "paragraph": 47,
      "part": 3,
      "start": 1149.726,
      "end": 1188.6,
      "duration": 38.874,
      "words": 86,
      "lead": "И ещё одна статья расходов, о которой реже говорят в рекламе: электричество."
    },
    {
      "paragraph": 48,
      "part": 4,
      "start": 1188.6,
      "end": 1215.699,
      "duration": 27.099,
      "words": 59,
      "lead": "Помните доткомы?"
    },
    {
      "paragraph": 49,
      "part": 4,
      "start": 1216.049,
      "end": 1218.346,
      "duration": 2.297,
      "words": 5,
      "lead": "Позиция пятая."
    },
    {
      "paragraph": 50,
      "part": 4,
      "start": 1218.696,
      "end": 1261.87,
      "duration": 43.175,
      "words": 94,
      "lead": "Самый дорогой товар в мире ИИ это слово скоро."
    },
    {
      "paragraph": 51,
      "part": 4,
      "start": 1262.22,
      "end": 1289.779,
      "duration": 27.558,
      "words": 60,
      "lead": "То же с автономными автомобилями."
    },
    {
      "paragraph": 52,
      "part": 4,
      "start": 1290.129,
      "end": 1339.734,
      "duration": 49.605,
      "words": 108,
      "lead": "Сейчас ровно такое же скоро навешено на агентов."
    },
    {
      "paragraph": 53,
      "part": 4,
      "start": 1340.084,
      "end": 1362.131,
      "duration": 22.047,
      "words": 48,
      "lead": "Итак, пункт пятый."
    },
    {
      "paragraph": 54,
      "part": 4,
      "start": 1362.481,
      "end": 1371.207,
      "duration": 8.727,
      "words": 19,
      "lead": "Остался вопрос, который вы, возможно, задаёте себе уже давно: если всё так неоднозначно, почему вокруг в основном слышен восторг?"
    },
    {
      "paragraph": 55,
      "part": 4,
      "start": 1371.557,
      "end": 1401.412,
      "duration": 29.855,
      "words": 65,
      "lead": "Ответ скучный и работает всегда: посмотрите, кому платят за восторг."
    },
    {
      "paragraph": 56,
      "part": 4,
      "start": 1401.762,
      "end": 1422.431,
      "duration": 20.669,
      "words": 45,
      "lead": "И блогеры, конечно."
    },
    {
      "paragraph": 57,
      "part": 4,
      "start": 1422.781,
      "end": 1450.799,
      "duration": 28.018,
      "words": 61,
      "lead": "Эту механику даже регуляторы заметили."
    },
    {
      "paragraph": 58,
      "part": 4,
      "start": 1451.149,
      "end": 1469.98,
      "duration": 18.832,
      "words": 41,
      "lead": "Если держать в голове эту механику, многое встаёт на места."
    },
    {
      "paragraph": 59,
      "part": 4,
      "start": 1470.33,
      "end": 1485.488,
      "duration": 15.157,
      "words": 33,
      "lead": "Мы прошли пять пунктов счёта."
    },
    {
      "paragraph": 60,
      "part": 4,
      "start": 1485.838,
      "end": 1518.448,
      "duration": 32.611,
      "words": 71,
      "lead": "Первое."
    },
    {
      "paragraph": 61,
      "part": 4,
      "start": 1518.798,
      "end": 1551.409,
      "duration": 32.611,
      "words": 71,
      "lead": "Второе."
    },
    {
      "paragraph": 62,
      "part": 4,
      "start": 1551.759,
      "end": 1604.12,
      "duration": 52.361,
      "words": 114,
      "lead": "Третье, и тут всё неоднозначно."
    },
    {
      "paragraph": 63,
      "part": 5,
      "start": 1604.12,
      "end": 1634.253,
      "duration": 30.133,
      "words": 69,
      "lead": "И четвёртое, самое тонкое."
    },
    {
      "paragraph": 64,
      "part": 5,
      "start": 1634.603,
      "end": 1643.773,
      "duration": 9.171,
      "words": 21,
      "lead": "Теперь обещанный тест."
    },
    {
      "paragraph": 65,
      "part": 5,
      "start": 1644.123,
      "end": 1671.636,
      "duration": 27.512,
      "words": 63,
      "lead": "Вопрос первый: проверить быстрее, чем сделать?"
    },
    {
      "paragraph": 66,
      "part": 5,
      "start": 1671.986,
      "end": 1696.878,
      "duration": 24.892,
      "words": 57,
      "lead": "Вопрос второй: сколько стоит ошибка?"
    },
    {
      "paragraph": 67,
      "part": 5,
      "start": 1697.228,
      "end": 1728.234,
      "duration": 31.006,
      "words": 71,
      "lead": "Вопрос третий: знаю ли я тему достаточно, чтобы заметить враньё?"
    },
    {
      "paragraph": 68,
      "part": 5,
      "start": 1728.584,
      "end": 1771.381,
      "duration": 42.797,
      "words": 98,
      "lead": "Вопрос четвёртый: что показывает секундомер?"
    },
    {
      "paragraph": 69,
      "part": 5,
      "start": 1771.731,
      "end": 1801.863,
      "duration": 30.133,
      "words": 69,
      "lead": "Вопрос пятый, и вот тут пригодится тот вопрос, который я задавал вам посередине ролика: когда вы в последний раз проверяли ответ ИИ по первоисточнику?"
    },
    {
      "paragraph": 70,
      "part": 5,
      "start": 1802.213,
      "end": 1831.036,
      "duration": 28.822,
      "words": 66,
      "lead": "Давайте подведём счёт."
    },
    {
      "paragraph": 71,
      "part": 5,
      "start": 1831.386,
      "end": 1849.727,
      "duration": 18.342,
      "words": 42,
      "lead": "И теперь самое главное."
    },
    {
      "paragraph": 72,
      "part": 5,
      "start": 1850.077,
      "end": 1873.66,
      "duration": 23.582,
      "words": 54,
      "lead": "Помните шестнадцать программистов из начала ролика?"
    },
    {
      "paragraph": 73,
      "part": 5,
      "start": 1874.01,
      "end": 1901.085,
      "duration": 27.076,
      "words": 62,
      "lead": "Теперь у меня к вам просьба."
    },
    {
      "paragraph": 74,
      "part": 5,
      "start": 1901.435,
      "end": 1931.131,
      "duration": 29.696,
      "words": 68,
      "lead": "А теперь о подписке, раз уж вы досмотрели до конца."
    },
    {
      "paragraph": 75,
      "part": 5,
      "start": 1931.481,
      "end": 1958.12,
      "duration": 26.639,
      "words": 61,
      "lead": "И последнее."
    }
  ],
